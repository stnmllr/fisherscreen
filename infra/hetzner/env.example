# Template for /etc/fisherscreen/env (root:root, mode 0600). systemd reads
# EnvironmentFile= as root before dropping to User=stef, so the service user
# never needs read access. Values are NOT stored in the repo.
# sa.json is different: the Python process opens it itself -> root:stef, 0640.

FISHERSCREEN_GCP_PROJECT_ID=fisherscreen-prod
FISHERSCREEN_EDGAR_USER_AGENT=FisherScreen/1.0 stn.mueller@gmail.com
FISHERSCREEN_GEMINI_API_KEY=
# Optional; without it OpenFIGI runs on the anonymous rate limit.
FISHERSCREEN_OPENFIGI_API_KEY=

# Firestore access (dev_deepdive_peers, dev_ticker_cache, dev_gemini_scores, ...)
GOOGLE_APPLICATION_CREDENTIALS=/etc/fisherscreen/sa.json

# Served behind Caddy at https://macro.stnmllr.com/deepdive/ — the prefix is
# NOT stripped by Caddy; the app routes /deepdive/... itself via root_path.
FISHERSCREEN_DEEPDIVE_UI_ROOT_PATH=/deepdive
FISHERSCREEN_DEEPDIVE_UI_VIEWER_URL=https://macro.stnmllr.com/fisher
