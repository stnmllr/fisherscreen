# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
dist/

# uv / venv
.venv/

# Environment — never commit secrets
.env
*.env.local

# Filing-Cache (ADR-4, Tool B Deep Dive — never commit cached EDGAR filings).
# Root-anchored so the pattern cannot also match a future app/cache/ source package
# and exclude it from the Cloud Build context (same failure class that hit /output/,
# see below + PR #27, 2026-06-09). The real cache lives at repo-root cache/filings/.
/cache/

# GCP service account keys only (not all JSON)
*-credentials.json
service-account-*.json
*-sa-key.json

# Claude Code
.claude/

# Editor
.vscode/settings.json
*.swp
*.swo

# OS
Thumbs.db
desktop.ini

# Generated outputs (cold-runs, dossiers, watchlists) — root-anchored so the pattern
# cannot also match the app/output/ source package. An unanchored `output/` excluded
# app/output/ from the Cloud Build context -> ModuleNotFoundError 'app.output' in prod (2026-06-09).
/output/
/output-test/

# Diagnose-Berichte gehoeren nach docs/superpowers/diagnostic-reports/. `reports/`
# entstand einmal versehentlich als zweiter Ablageort (2026-09-07) — der Pfad ist im
# Skript korrigiert, dieser Eintrag verhindert, dass ein `--report reports/...` die
# Doppelablage still wieder anlegt. Root-anchored, wie alle Generated-Output-Muster.
/reports/
